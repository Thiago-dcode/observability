# Copy to .env (never commit .env). Every variable except the password has a default, so an empty
# or missing line is fine; uncomment a line only to change it.

# REQUIRED. No default on purpose: Compose refuses to start without it. Only used when Grafana
# creates its database; an existing grafana.db keeps its login.
GRAFANA_ADMIN_PASSWORD=

# Host address the gateway publishes the ingest port (3100) on. Default: 127.0.0.1.
# On the VPS: the WireGuard address (10.8.0.4), so it exists only on the tunnel interface.
INGEST_BIND=127.0.0.1

# Host address the Grafana UI is published on (3001). Default: 127.0.0.1. Keep it: a peer on the
# tunnel must not be able to reach the login page. On the VPS use `ssh -L 3001:127.0.0.1:3001`.
UI_BIND=127.0.0.1

# ---- Loki (defaults live in loki/config.yaml; the values below are those defaults) ----
# How long logs are kept before Loki deletes them (needs disk: size it to the VPS).
#LOKI_RETENTION=720h
# Refuse log lines older than this at write time.
#LOKI_REJECT_OLD_SAMPLES_MAX_AGE=168h
# Ingestion limits: MB/s accepted, allowed burst in MB, and the per-stream rate per second.
#LOKI_INGESTION_RATE_MB=4
#LOKI_INGESTION_BURST_MB=6
#LOKI_PER_STREAM_RATE_LIMIT=3MB
