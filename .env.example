# Copy to .env (never commit .env).
GRAFANA_ADMIN_PASSWORD=

# Host address the gateway publishes the ingest port (3100) on. Local: 127.0.0.1.
# On the VPS: the WireGuard address (10.8.0.4), so it exists only on the tunnel interface.
INGEST_BIND=127.0.0.1

# Host address the Grafana UI is published on (3001). Keep 127.0.0.1 everywhere: a peer on the
# tunnel must not be able to reach the login page. On the VPS use `ssh -L 3001:127.0.0.1:3001`.
UI_BIND=127.0.0.1
